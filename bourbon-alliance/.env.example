# ==============================================================================
# Bourbon Alliance (bourbonalliance.net) Production Environment Configuration
# ==============================================================================

# APP_URL: Base URL of your deployment
APP_URL="https://bourbonalliance.net"

# ------------------------------------------------------------------------------
# 1. GOOGLE OAUTH 2.0 (Google Identity Services)
# ------------------------------------------------------------------------------
# Setup in Google Cloud Console -> APIs & Services -> Credentials
# Authorized Javascript origins:
#   - https://bourbonalliance.net
#   - http://localhost:3000
VITE_GOOGLE_CLIENT_ID="19323179551-81fncrrnrv1gv690a98agpu8to55mtej.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 2. TWILIO SMS GATEWAY (For live cellular drop alerts to phone numbers)
# ------------------------------------------------------------------------------
# Sign up at https://www.twilio.com (Console Dashboard)
VITE_TWILIO_ACCOUNT_SID=""
VITE_TWILIO_AUTH_TOKEN=""
VITE_TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL GATEWAY (For daily morning digest notes)
# ------------------------------------------------------------------------------
# Options: Resend (https://resend.com), SendGrid, or Postmark
VITE_RESEND_API_KEY=""
VITE_NOTIFICATION_FROM_EMAIL="alerts@bourbonalliance.net"

# ------------------------------------------------------------------------------
# 4. CUSTOM WEBHOOK (Optional alternative: Discord, Slack, Pushover)
# ------------------------------------------------------------------------------
VITE_ALERT_WEBHOOK_URL=""

# Server runtime
PORT=3000
NODE_ENV="production"
