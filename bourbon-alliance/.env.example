# Bourbon Alliance (bourbonalliance.net) Environment Configuration

# APP_URL: Base URL of your deployment (e.g. https://bourbonalliance.net)
APP_URL="https://bourbonalliance.net"

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID for Google Authentication
# Set up via Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""

# PORT: Server listener port (Default 3000)
PORT=3000

# NODE_ENV: production or development
NODE_ENV="development"

